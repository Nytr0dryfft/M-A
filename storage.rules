rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Bloqueio padrão para todas as pastas e caminhos não autorizados
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Pasta isolada de cada pedido: /orders/{orderId}/{fileName}
    match /orders/{orderId}/{fileName} {
      // 1. Proíbe expressamente a listagem de arquivos da pasta.
      // Nenhum visitante consegue navegar, explorar ou descobrir os arquivos de outros pedidos.
      allow list: if false;

      // 2. Leitura permitida apenas para download direto do arquivo através da sua URL com token
      // de acesso (utilizado pelo marceneiro para abrir os links recebidos no e-mail).
      allow get: if true;

      // 3. Criação de novos arquivos estritamente restrita a:
      // - Usuário autenticado
      // - Tamanho máximo de 15 MB por arquivo
      // - Tipos de arquivo estritamente verificados: imagens (PNG/JPEG/WEBP), vetores SVG ou relatórios JSON
      allow create: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'image/svg+xml'
          || request.resource.contentType == 'application/json'
        );

      // 4. Bloqueio permanente de alterações e exclusões via cliente web
      // Garante que uma arte ou ficha CNC já enviada não possa ser sobrescrita ou apagada.
      allow update, delete: if false;
    }

    // Galeria de fotografias de clientes do Ateliê:
    // - Leitura e listagem pública para visitantes visualizarem as fotos e miniaturas (inclusive em subpastas)
    // - Criação, atualização e exclusão restritas ao administrador autorizado
    // - Rejeita uploads indiscriminados de visitantes anônimos comuns
    // - Validação estrita: somente imagens até 15 MB e metadados JSON até 1 MB
    match /customer_photos/{fileName=**} {
      allow get, list: if true;
      allow create, update: if isAuthorizedAdmin()
        && request.resource.size < 15 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/json'
        );
      allow delete: if isAuthorizedAdmin();
    }

    // Função de verificação do administrador do Atelier:
    // Exige autenticação e verificação de autorização administrativa
    function isAuthorizedAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true
        || request.auth.token.email == 'matheusslpes2013@gmail.com'
        || (request.resource != null && request.resource.metadata != null && request.resource.metadata.role == 'admin')
        || (resource != null && resource.metadata != null && resource.metadata.role == 'admin')
      );
    }
  }
}
