# GEMINI_API_KEY: Required for Gemini AI API calls (se utilizado no backend/desenvolvimento).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL onde o site está publicado (ex: https://seu-usuario.github.io/atelier-ma ou https://atelierma.com.br)
