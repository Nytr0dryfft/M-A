# GEMINI_API_KEY: Required for Gemini AI API calls (se utilizado no backend/desenvolvimento).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL onde o site está publicado (ex: https://seu-usuario.github.io/atelier-ma ou https://atelierma.com.br)
APP_URL="https://seu-usuario.github.io/atelier-ma"

# FIREBASE CONFIGURATION (Armazenamento Estático para GitHub Pages)
# Obtenha estas credenciais no console do Firebase: Configurações do Projeto > Geral > Seus Aplicativos > Web SDK.
# No GitHub Actions, cadastre estas variáveis em Settings > Secrets and variables > Actions.
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef"
