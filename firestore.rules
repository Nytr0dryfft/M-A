rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Bloqueio padrão para todas as coleções não explicitamente liberadas
    match /{document=**} {
      allow read, write: if false;
    }

    // Controle de Cotas e Rate-Limiting por Usuário Autenticado (Atelier M&A)
    // Impede abusos, robôs e criação de orçamentos infinitos
    match /quote_rate_limits/{userId} {
      // O usuário pode apenas consultar seu próprio saldo de cota
      allow read: if request.auth != null && request.auth.uid == userId;

      // Criação e atualização com verificação estrita: máximo 3 orçamentos na janela de 24h
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.totalRequests24h is int
        && request.resource.data.totalRequests24h >= 1
        && request.resource.data.totalRequests24h <= 3
        && request.resource.data.requestTimestamps is list
        && request.resource.data.requestTimestamps.size() <= 3;

      // Proibido apagar o registro: o visitante NÃO consegue zerar a cota deletando o documento
      allow delete: if false;
    }

    // Regras de Segurança para Orçamentos e Pedidos Sob Medida (Atelier M&A)
    match /orders/{orderId} {
      // Criação permitida apenas com autenticação e validação rigorosa de campos
      allow create: if isValidOrderId(orderId)
        && isValidOrderData(request.resource.data)
        && request.resource.data.orderId == orderId
        && request.resource.data.status == 'solicitado'
        && request.resource.data.createdAt == request.time;

      // Leitura pública bloqueada para proteger dados de contato e artes autorais dos clientes.
      // O marceneiro recebe os links diretos autenticados no e-mail ou no WhatsApp.
      allow read: if false;

      // Proibida modificação ou deleção pelo navegador do cliente após o envio
      allow update, delete: if false;
    }

    // Galeria Real de Fotos de Clientes cadastradas pelo Administrador
    match /customer_photos/{photoId} {
      // Leitura pública de fotos publicadas
      allow read: if resource.data.published == true || request.auth != null;
      // Escrita restrita ao administrador autenticado
      allow write: if request.auth != null;
    }

    // Funções de validação estrita (Anti-Gap e Anti-Poisoning)
    function isValidOrderId(id) {
      return id is string
        && id.size() >= 5
        && id.size() <= 40
        && id.matches('^[A-Z0-9\\-]+$');
    }

    function isValidOrderData(data) {
      return data.keys().hasAll([
        'orderId',
        'createdAt',
        'clientName',
        'clientContact',
        'pieceType',
        'pieceLabel',
        'woodId',
        'woodName',
        'dimensions',
        'technique',
        'finish',
        'quantity',
        'budget',
        'status',
        'source'
      ])
      && data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 120
      && data.clientContact is string && data.clientContact.size() >= 8 && data.clientContact.size() <= 40
      && data.quantity is int && data.quantity >= 1 && data.quantity <= 100
      && data.source == 'web_configurator';
    }
  }
}
