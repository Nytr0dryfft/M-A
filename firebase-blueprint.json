{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "Pedido ou orçamento sob medida gerado pelo configurador CNC do Atelier M&A",
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "description": "Identificador único do pedido",
          "pattern": "^[A-Z0-9\\-]+$",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data e hora de registro no servidor"
        },
        "clientName": {
          "type": "string",
          "description": "Nome completo do cliente",
          "maxLength": 120,
          "minLength": 2
        },
        "clientContact": {
          "type": "string",
          "description": "Telefone ou WhatsApp de contato",
          "maxLength": 40,
          "minLength": 8
        },
        "clientEmail": {
          "type": "string",
          "description": "E-mail para cópia da ficha técnica",
          "maxLength": 120
        },
        "pieceType": {
          "type": "string",
          "enum": ["tabua_carne", "porta_copos"],
          "description": "Tipo da peça do atelier"
        },
        "pieceLabel": {
          "type": "string",
          "description": "Nome descritivo da peça"
        },
        "woodId": {
          "type": "string",
          "description": "Identificador da madeira"
        },
        "woodName": {
          "type": "string",
          "description": "Nome da espécie de madeira"
        },
        "technique": {
          "type": "string",
          "description": "Técnica de usinagem e acabamento CNC"
        },
        "finish": {
          "type": "string",
          "description": "Tipo de cura e selamento"
        },
        "quantity": {
          "type": "integer",
          "description": "Quantidade de unidades solicitadas"
        },
        "previewUrl": {
          "type": "string",
          "description": "URL pública de download da prévia visual da peça no Firebase Storage"
        },
        "status": {
          "type": "string",
          "enum": ["solicitado", "analise_tecnica", "aprovado", "em_producao", "concluido"],
          "description": "Estado atual do orçamento"
        },
        "source": {
          "type": "string",
          "enum": ["web_configurator"]
        }
      },
      "required": [
        "orderId",
        "createdAt",
        "clientName",
        "clientContact",
        "pieceType",
        "pieceLabel",
        "woodId",
        "woodName",
        "technique",
        "finish",
        "quantity",
        "status",
        "source"
      ]
    },
    "CustomerPhoto": {
      "title": "CustomerPhoto",
      "description": "Fotografia real de peça artesanal entregue pelo Atelier M&A",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID único da fotografia"
        },
        "imageUrl": {
          "type": "string",
          "description": "URL da imagem original em alta resolução no Firebase Storage"
        },
        "thumbnailUrl": {
          "type": "string",
          "description": "URL da miniatura compacta (<80KB) otimizada para carregamento progressivo"
        },
        "title": {
          "type": "string",
          "description": "Título descritivo da peça"
        },
        "category": {
          "type": "string",
          "description": "Categoria da peça (ex: Tábuas de Carne, Porta-copos, Mesas)"
        },
        "wood": {
          "type": "string",
          "description": "Espécie de madeira utilizada"
        },
        "clientName": {
          "type": "string",
          "description": "Nome autorizado do cliente"
        },
        "isNameAuthorized": {
          "type": "boolean",
          "description": "Indica se o cliente autorizou a publicação do nome"
        },
        "city": {
          "type": "string",
          "description": "Cidade e estado de entrega"
        },
        "rating": {
          "type": "number",
          "description": "Nota real de satisfação (1 a 5)"
        },
        "comment": {
          "type": "string",
          "description": "Depoimento real do cliente"
        },
        "published": {
          "type": "boolean",
          "description": "Se a foto está visível ao público"
        },
        "order": {
          "type": "integer",
          "description": "Ordem de exibição na galeria"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "imageUrl", "category", "published", "order", "createdAt"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Coleção segura de pedidos e orçamentos do configurador"
    },
    "/customer_photos/{photoId}": {
      "schema": "CustomerPhoto",
      "description": "Galeria real de fotografias compartilhadas de clientes do Atelier M&A"
    }
  }
}
